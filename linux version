#analyze the file

def parse_line(line):
    part = line.split('|')
    lines = {
        'Date_time': part[0].strip().split('=')[0],
        'Level': part[1].strip().split('=')[0],
        'User': part[2].strip().split('=')[1],
        'Action': part[3].strip().split('=')[1],
        'Status': part[4].strip().split('=')[1],
    }
    return lines


#======================================================================================

def count_login(all_logs):
    counter_list = {}

    for log in all_logs:
        name = log['User']

        if name not in counter_list:
            counter_list[name] = {
                'Success': 0,
                'Failed': 0
            }

        if log['Action'] == 'login':
            if log['Status'] == 'success':
                counter_list[name]['Success'] += 1
            elif log['Status'] == 'failed':
                counter_list[name]['Failed'] += 1
    return counter_list


