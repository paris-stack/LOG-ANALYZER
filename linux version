#======================================================================================

def security_check():
    print('\n========================================')
    print('          SYSTEM CHECK\n========================================')

    os_release = platform.release()
    operating_system = platform.system()
    architecture = platform.machine()
    python_version = platform.python_version()

    if operating_system == "Windows":
        os_status = 'Checked'
    elif operating_system == "Linux":
        os_status = 'Checked'
    else:
        os_status = 'Unverified'

    if architecture in ["AMD64", "x86_64", "aarch64", "ARM64"]:
        architecture_status = 'Supported'
    else:
        architecture_status = 'Unknown'

    if python_version in ['3.12.13', '3.12.11', '3.13.5']:
        python_version_verified = 'Verified'
    else:
        python_version_verified = 'Unknown'

    security = {
        'Operating system:': operating_system,
        'OS release:': os_release,
        'Architecture:': architecture,
        'OS Status': os_status,
        'Architecture Status': architecture_status,
        'Python': python_version,
        'Python status': python_version_verified
    }

    for keys, values in security.items():
        print(keys, '|', values)

    return security


