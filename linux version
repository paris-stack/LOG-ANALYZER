# detect suspicious failed 

def detect_suspicious(result_2):
    alerts = []

    # partie sauvegarde

    for user, stats in result_2.items():
        if stats['Failed'] >= 3:
            message = {
                'Level': "CRITICAL",
                'User': user,
                'Failed': stats['Failed']
            }
            alerts.append(message)

        elif stats['Failed'] == 2:
            message_1 = {
                'Level': "WARNING",
                'User': user,
                'Failed': stats['Failed']
            }
            alerts.append(message_1)

        elif stats['Failed'] == 1:
            message_2 = {
                'Level': "INFO",
                'User': user,
                'Failed': stats['Failed']
            }
            alerts.append(message_2)

    return alerts


