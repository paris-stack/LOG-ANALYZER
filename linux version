#this part main goal is to read and modify the charachteres to *
def input_password(show_password=False):
    fd = sys.stdin.fileno()
    original_settings = termios.tcgetattr(fd)
    password = ''
    try:
        tty.setraw(fd)
        while True:
            char = sys.stdin.read(1)
            if char == '\n' or  char == '\r':
                break
            elif char == '\x7f':
                if len(password) > 0:
                    password = password[:-1]
                    sys.stdout.write('\b' '\b')
                    sys.stdout.flush()
            elif char == '\x03':
                raise KeyboardInterrupt('Keyboard interruption')
            else:
                password += char

                if show_password:
                    print(char, end='', flush=True)
                else:
                    print("*", end='', flush=True)
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, original_settings)
        print()
    return password 


        


